# Copy to .env and fill in. Never commit .env.

# Runtime
PORT=3000
NODE_ENV=development

# Absolute path to the SQLite file. On Railway this is /data/clientroom.db
DATABASE_PATH=./data/clientroom.db

# Public HTTPS origin of the app. Used for share links and cookie security.
APP_ORIGIN=http://localhost:5173

# 32+ random bytes. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Optional. When set, boot creates a demo account with sample data.
# SEED_DEMO=1
# SEED_EMAIL=demo@example.com
# SEED_PASSWORD=
